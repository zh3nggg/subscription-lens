:root{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#172033;background:#f6f7fb;font-synthesis:none}*{box-sizing:border-box}body{margin:0;display:flex;min-height:100vh}.sidebar{width:224px;background:#fff;border-right:1px solid #e7e9ef;padding:28px 18px;display:flex;flex-direction:column;gap:36px}.brand{display:flex;align-items:center;gap:10px;font-weight:700;font-size:16px}.brand-mark{width:32px;height:32px;border-radius:10px;background:#101827;color:#fff;display:grid;place-items:center;font-size:20px}.nav-item{display:block;width:100%;text-align:left;border:0;background:transparent;border-radius:10px;padding:13px 14px;margin:4px 0;color:#6f7786;font-size:14px;cursor:pointer}.nav-item.active,.nav-item:hover{background:#eef1f8;color:#182234;font-weight:600}.runtime-badge{margin-top:auto;color:#768195;font-size:12px;display:flex;gap:8px;align-items:center;padding:10px}.dot{width:8px;height:8px;border-radius:50%;background:#f0ad4e}.content{flex:1;padding:0 42px 48px;max-width:1440px}.topbar{height:76px;border-bottom:1px solid #e7e9ef;display:flex;align-items:center;justify-content:space-between;color:#667085;font-size:13px}.hero{display:flex;justify-content:space-between;align-items:flex-start;padding:44px 0 30px}.eyebrow{font-size:11px;letter-spacing:.14em;color:#6d7ee9;font-weight:700;margin:0 0 10px}.hero h1{font-size:34px;letter-spacing:-.04em;margin:0 0 10px}.muted{color:#7c8799;font-size:13px;margin:6px 0}.button{border:0;border-radius:10px;background:#596eea;color:#fff;padding:11px 18px;font-size:13px;cursor:pointer}.button.secondary{background:#fff;color:#334155;border:1px solid #dce1eb}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:18px}.card{background:#fff;border:1px solid #e4e7ee;border-radius:16px;box-shadow:0 8px 30px rgba(27,39,67,.05)}.stat{padding:22px;display:flex;flex-direction:column;gap:8px}.label{color:#7c8799;font-size:13px}.stat strong{font-size:25px;letter-spacing:-.03em}.provider-card{padding:24px}.section-head{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:20px}.section-head h2{margin:0;font-size:20px}.providers{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.provider{border:1px solid #edf0f5;border-radius:12px;padding:16px;display:flex;justify-content:space-between;align-items:center}.provider.active{border-color:#9aa8f2;background:#f8f9ff}.provider-name{font-weight:600}.provider-meta{color:#7c8799;font-size:12px;margin-top:5px}.pill{border-radius:999px;padding:5px 9px;background:#ecf8f0;color:#27804b;font-size:11px}.empty{padding:28px;color:#8b95a7;text-align:center;background:#fafbfc;border-radius:12px}@media(max-width:800px){.sidebar{width:170px}.content{padding:0 22px 32px}.grid,.providers{grid-template-columns:1fr}.hero h1{font-size:28px}}
