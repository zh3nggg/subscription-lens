{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Subscription Lens",
  "version": "3.0.0",
  "identifier": "com.subscriptionlens.desktop",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Subscription Lens",
        "width": 1200,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "visible": true,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: http:; script-src 'self' 'sha256-ls27Lc1OytcVawXPVMplz6LyKz2i9KYAVBw3u79qyB4='; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https: http:"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["subscriptionlens"]
      }
    },
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md",
      "../cc-switch-runtime/LICENSE": "licenses/CC-Switch-MIT.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
