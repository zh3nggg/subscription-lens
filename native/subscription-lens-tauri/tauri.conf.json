{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Subscription Lens",
  "version": "3.0.0-beta.1",
  "identifier": "com.subscriptionlens.desktop",
  "build": {
    "frontendDist": "../cc-switch-runtime/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Subscription Lens",
        "width": 1200,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "visible": false,
        "resizable": true,
        "center": true,
        "dataDirectory": "webview"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https: http:"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["subscriptionlens"]
      }
    },
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
