+/// List object keys under an S3 prefix. Used by the Sublens device snapshot
+/// sync; the caller applies a strict object-key allowlist before downloading.
+pub(crate) async fn list_objects_v2(
+    creds: &S3Credentials,
+    prefix: &str,
+    continuation: Option<&str>,
+) -> Result<(Vec<String>, Option<String>, bool), AppError> {
+    let mut url = Url::parse(&build_bucket_url(creds)).map_err(|e| {
+        AppError::localized(
+            "s3.url.invalid",
+            format!("S3 URL 无效: {e}"),
+            format!("Invalid S3 URL: {e}"),
+        )
+    })?;
+    {
+        let mut query = url.query_pairs_mut();
+        query.append_pair("list-type", "2");
+        query.append_pair("prefix", prefix);
+        query.append_pair("max-keys", "1000");
+        if let Some(token) = continuation {
+            query.append_pair("continuation-token", token);
+        }
+    }
+
+    let client = http_client::get();
+    let mut headers = reqwest::header::HeaderMap::new();
+    sign_request(
+        "GET",
+        &url,
+        &mut headers,
+        &sha256_hex(b""),
+        creds,
+        chrono::Utc::now(),
+    );
+    let response = client
+        .get(url.as_str())
+        .headers(headers)
+        .timeout(Duration::from_secs(DEFAULT_TIMEOUT_SECS))
+        .send()
+        .await
+        .map_err(|e| s3_transport_error("s3.list_failed", "列举对象", "list objects", &e))?;
+    if !response.status().is_success() {
+        return Err(s3_status_error("ListObjectsV2", response.status(), url.as_str()));
+    }
+    let bytes = response.bytes().await.map_err(|e| {
+        AppError::localized(
+            "s3.list_read_failed",
+            format!("读取 S3 对象列表失败: {e}"),
+            format!("Failed to read S3 object list: {e}"),
+        )
+    })?;
+
+    let mut reader = quick_xml::Reader::from_reader(bytes.as_ref());
+    reader.config_mut().trim_text(true);
+    let mut buffer = Vec::new();
+    let mut current = String::new();
+    let mut keys = Vec::new();
+    let mut next = None;
+    let mut truncated = false;
+    loop {
+        match reader.read_event_into(&mut buffer) {
+            Ok(quick_xml::events::Event::Start(event)) => {
+                current = String::from_utf8_lossy(event.local_name().as_ref()).into_owned();
+            }
+            Ok(quick_xml::events::Event::Text(event)) => {
+                let decoded = event.decode().map_err(|e| {
+                    AppError::localized("s3.xml.invalid", e.to_string(), e.to_string())
+                })?;
+                let value = quick_xml::escape::unescape(&decoded).map_err(|e| {
+                    AppError::localized("s3.xml.invalid", e.to_string(), e.to_string())
+                })?;
+                match current.as_str() {
+                    "Key" if !value.is_empty() => keys.push(value.into_owned()),
+                    "NextContinuationToken" if !value.is_empty() => next = Some(value.into_owned()),
+                    "IsTruncated" => truncated = value.eq_ignore_ascii_case("true"),
+                    _ => {}
+                }
+            }
+            Ok(quick_xml::events::Event::End(_)) => current.clear(),
+            Ok(quick_xml::events::Event::Eof) => break,
+            Ok(_) => {}
+            Err(error) => {
+                return Err(AppError::localized(
+                    "s3.xml.invalid",
+                    format!("S3 对象列表 XML 无效: {error}"),
+                    format!("Invalid S3 object list XML: {error}"),
+                ));
+            }
+        }
+        buffer.clear();
+    }
+    Ok((keys, next, truncated))
+}
