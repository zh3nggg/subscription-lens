+fn add_group(map: &mut BTreeMap<String, Value>, key: String, provider: &str, model: &str, tokens: u64, usd: Option<f64>, day: bool) {
+    let g = map.entry(key.clone()).or_insert_with(|| json!({
+        "key":key, "provider":if day { "" } else { provider }, "model":if day { "" } else { model },
+        "tokens":0,"pricedTokens":0,"requests":0,"estimated":0.0,"reported":0.0,
+        "estimatedRecords":0,"reportedRecords":0,"unpriced":0
+    }));
+    g["tokens"] = json!(g["tokens"].as_u64().unwrap_or(0) + tokens);
+    g["requests"] = json!(g["requests"].as_u64().unwrap_or(0) + 1);
+    if let Some(usd) = usd {
+        g["pricedTokens"] = json!(g["pricedTokens"].as_u64().unwrap_or(0) + tokens);
+        g["estimated"] = json!(g["estimated"].as_f64().unwrap_or(0.0) + usd);
+        g["estimatedRecords"] = json!(g["estimatedRecords"].as_u64().unwrap_or(0) + 1);
+    } else { g["unpriced"] = json!(g["unpriced"].as_u64().unwrap_or(0) + 1); }
+}
