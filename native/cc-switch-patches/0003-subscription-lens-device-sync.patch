@@ -0,0 +1,440 @@
+//! Privacy-filtered per-device Codex usage snapshots synced through Cloudflare R2.
+//! The bucket contains one Sublens JSON snapshot per device under a fixed prefix;
+//! no source logs, project paths, chat bodies, credentials or raw request IDs leave this app.
+
+use chrono::{DateTime, Utc};
+use rusqlite::{params, Connection, OptionalExtension};
+use serde::{Deserialize, Serialize};
+use serde_json::{json, Value};
+use sha2::{Digest, Sha256};
+use std::{fs, path::PathBuf};
+use tauri::{AppHandle, Manager, State};
+
+use crate::{
+    services::{s3::{self, S3Credentials}, usage_stats::{LogFilters, RequestLogDetail}},
+    store::AppState,
+};
+
+const SNAPSHOT_SCHEMA: &str = "subscription-lens.device-ledger.v2";
+const DEFAULT_PREFIX: &str = "subscription-lens/devices";
+const MAX_DEVICES: usize = 100;
+const MAX_RECORDS: u32 = 200_000;
+const MAX_OBJECT_BYTES: usize = 24 * 1024 * 1024;
+const MAX_SYNC_BYTES: usize = 128 * 1024 * 1024;
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct DeviceConfig {
+    #[serde(default)] account_id: String,
+    #[serde(default)] bucket: String,
+    #[serde(default = "default_prefix")] prefix: String,
+    #[serde(default)] device_id: String,
+    #[serde(default)] device_name: String,
+}
+
+fn default_prefix() -> String { DEFAULT_PREFIX.to_string() }
+fn now() -> String { Utc::now().to_rfc3339_opts(chrono::SecondsFormat::Millis, true) }
+fn digest(value: &str) -> String { format!("{:x}", Sha256::digest(value.as_bytes())) }
+
+fn storage_paths(app: &AppHandle) -> Result<(PathBuf, PathBuf), String> {
+    let dir = app.path().app_data_dir().map_err(|e| e.to_string())?;
+    fs::create_dir_all(&dir).map_err(|e| format!("创建设备同步目录失败：{e}"))?;
+    Ok((dir.join("device-sync.json"), dir.join("usage-monitor.sqlite3")))
+}
+
+fn database(app: &AppHandle) -> Result<Connection, String> {
+    let (_, path) = storage_paths(app)?;
+    let db = Connection::open(path).map_err(|e| format!("打开设备统计库失败：{e}"))?;
+    db.busy_timeout(std::time::Duration::from_secs(3)).map_err(|e| e.to_string())?;
+    db.execute_batch("CREATE TABLE IF NOT EXISTS sl_cloud_devices(
+        device_id TEXT PRIMARY KEY, label TEXT NOT NULL, updated_at TEXT NOT NULL, synced_at TEXT NOT NULL DEFAULT '', data TEXT NOT NULL, etag TEXT
+    );").map_err(|e| e.to_string())?;
+    let has_etag: bool = db.query_row("SELECT EXISTS(SELECT 1 FROM pragma_table_info('sl_cloud_devices') WHERE name='etag')", [], |r| r.get(0)).unwrap_or(false);
+    if !has_etag { db.execute("ALTER TABLE sl_cloud_devices ADD COLUMN etag TEXT", []).map_err(|e| e.to_string())?; }
+    let has_synced_at: bool = db.query_row("SELECT EXISTS(SELECT 1 FROM pragma_table_info('sl_cloud_devices') WHERE name='synced_at')", [], |r| r.get(0)).unwrap_or(false);
+    if !has_synced_at { db.execute("ALTER TABLE sl_cloud_devices ADD COLUMN synced_at TEXT NOT NULL DEFAULT ''", []).map_err(|e| e.to_string())?; }
+    Ok(db)
+}
+
+fn load_config(app: &AppHandle) -> Result<DeviceConfig, String> {
+    let (path, _) = storage_paths(app)?;
+    let mut config = if path.exists() {
+        serde_json::from_slice::<DeviceConfig>(&fs::read(path).map_err(|e| e.to_string())?)
+            .map_err(|e| format!("读取设备同步设置失败：{e}"))?
+    } else { DeviceConfig {
+        account_id: String::new(), bucket: String::new(), prefix: default_prefix(),
+        device_id: uuid::Uuid::new_v4().to_string(),
+        device_name: std::env::var("COMPUTERNAME").unwrap_or_else(|_| "This device".into()),
+    }};
+    if config.device_id.is_empty() { config.device_id = uuid::Uuid::new_v4().to_string(); }
+    if config.device_name.is_empty() { config.device_name = "This device".into(); }
+    Ok(config)
+}
+
+fn save_config(app: &AppHandle, config: &DeviceConfig) -> Result<(), String> {
+    let (path, _) = storage_paths(app)?;
+    let bytes = serde_json::to_vec_pretty(config).map_err(|e| e.to_string())?;
+    let temp = path.with_extension("json.tmp");
+    fs::write(&temp, bytes).map_err(|e| format!("保存设备同步设置失败：{e}"))?;
+    fs::rename(temp, path).map_err(|e| format!("写入设备同步设置失败：{e}"))
+}
+
+const CREDENTIAL_TARGET: &str = "Subscription Lens / Cloudflare R2 device sync";
+
+#[cfg(windows)]
+fn save_credentials(access: &str, secret: &str) -> Result<(), String> {
+    use std::mem;
+    use windows_sys::Win32::Security::Credentials::{CredWriteW, CREDENTIALW, CRED_PERSIST_LOCAL_MACHINE, CRED_TYPE_GENERIC};
+    let payload = serde_json::to_vec(&json!({"accessKeyId":access,"secretAccessKey":secret})).map_err(|e| e.to_string())?;
+    if payload.len() > 5_000 { return Err("R2 凭据长度超出系统凭据库限制".into()); }
+    let target: Vec<u16> = CREDENTIAL_TARGET.encode_utf16().chain(Some(0)).collect();
+    let username: Vec<u16> = "Cloudflare R2".encode_utf16().chain(Some(0)).collect();
+    let credential = CREDENTIALW {
+        Type: CRED_TYPE_GENERIC,
+        TargetName: target.as_ptr() as *mut _,
+        UserName: username.as_ptr() as *mut _,
+        CredentialBlobSize: payload.len() as u32,
+        CredentialBlob: payload.as_ptr() as *mut u8,
+        Persist: CRED_PERSIST_LOCAL_MACHINE,
+        ..unsafe { mem::zeroed() }
+    };
+    let ok = unsafe { CredWriteW(&credential, 0) };
+    if ok == 0 { return Err(format!("写入 Windows 凭据管理器失败：{}", std::io::Error::last_os_error())); }
+    Ok(())
+}
+
+#[cfg(windows)]
+fn load_credentials() -> Result<(String, String), String> {
+    use windows_sys::Win32::Security::Credentials::{CredFree, CredReadW, CREDENTIALW, CRED_TYPE_GENERIC};
+    let target: Vec<u16> = CREDENTIAL_TARGET.encode_utf16().chain(Some(0)).collect();
+    let mut pointer: *mut CREDENTIALW = std::ptr::null_mut();
+    let ok = unsafe { CredReadW(target.as_ptr(), CRED_TYPE_GENERIC, 0, &mut pointer) };
+    if ok == 0 { return Ok((String::new(), String::new())); }
+    let result = unsafe {
+        let item = &*pointer;
+        let bytes = std::slice::from_raw_parts(item.CredentialBlob, item.CredentialBlobSize as usize);
+        serde_json::from_slice::<Value>(bytes).map_err(|e| e.to_string())
+    };
+    unsafe { CredFree(pointer as *const _); }
+    let value = result?;
+    Ok((value["accessKeyId"].as_str().unwrap_or_default().to_string(), value["secretAccessKey"].as_str().unwrap_or_default().to_string()))
+}
+
+#[cfg(windows)]
+fn delete_credentials() -> Result<(), String> {
+    use windows_sys::Win32::Security::Credentials::{CredDeleteW, CRED_TYPE_GENERIC};
+    let target: Vec<u16> = CREDENTIAL_TARGET.encode_utf16().chain(Some(0)).collect();
+    let _ = unsafe { CredDeleteW(target.as_ptr(), CRED_TYPE_GENERIC, 0) };
+    Ok(())
+}
+
+#[cfg(not(windows))]
+fn save_credentials(_: &str, _: &str) -> Result<(), String> { Err("当前平台尚未提供系统凭据库适配".into()) }
+#[cfg(not(windows))]
+fn load_credentials() -> Result<(String, String), String> { Ok((String::new(), String::new())) }
+#[cfg(not(windows))]
+fn delete_credentials() -> Result<(), String> { Ok(()) }
+
+fn credentials(config: &DeviceConfig) -> Result<S3Credentials, String> {
+    if config.account_id.len() < 16 || !config.account_id.bytes().all(|b| b.is_ascii_hexdigit()) {
+        return Err("Cloudflare Account ID 格式无效".into());
+    }
+    if !valid_bucket(&config.bucket) { return Err("R2 bucket 名称需为 3–63 位小写字母、数字或连字符，且首尾为字母或数字".into()); }
+    let (access_key_id, secret_access_key) = load_credentials()?;
+    if access_key_id.is_empty() || secret_access_key.is_empty() { return Err("请先保存 R2 Access Key ID 和 Secret Access Key".into()); }
+    Ok(S3Credentials {
+        access_key_id, secret_access_key, region: "auto".into(), bucket: config.bucket.clone(),
+        endpoint: format!("https://{}.r2.cloudflarestorage.com", config.account_id),
+    })
+}
+
+fn valid_bucket(bucket: &str) -> bool {
+    let bytes = bucket.as_bytes();
+    (3..=63).contains(&bytes.len())
+        && bytes.first().is_some_and(|b| b.is_ascii_lowercase() || b.is_ascii_digit())
+        && bytes.last().is_some_and(|b| b.is_ascii_lowercase() || b.is_ascii_digit())
+        && bytes.iter().all(|b| b.is_ascii_lowercase() || b.is_ascii_digit() || *b == b'-')
+}
+
+fn object_prefix(config: &DeviceConfig) -> String {
+    format!("{}/", config.prefix.trim_matches('/'))
+}
+
+#[tauri::command]
+pub fn sublens_device_get_config(app: AppHandle) -> Result<Value, String> {
+    let config = load_config(&app)?;
+    let (access, secret) = load_credentials()?;
+    Ok(json!({
+        "accountId":config.account_id,"bucket":config.bucket,"prefix":config.prefix,
+        "deviceId":config.device_id,"deviceName":config.device_name,
+        "configured":!config.account_id.is_empty()&&!config.bucket.is_empty()&&!access.is_empty()&&!secret.is_empty(),
+        "credentialsSaved":!access.is_empty()&&!secret.is_empty()
+    }))
+}
+
+#[tauri::command(rename_all = "camelCase")]
+pub fn sublens_device_save_config(
+    app: AppHandle, account_id: String, bucket: String, prefix: String,
+    device_name: String, access_key_id: String, secret_access_key: String,
+) -> Result<Value, String> {
+    let mut config = load_config(&app)?;
+    config.account_id = account_id.trim().to_ascii_lowercase();
+    config.bucket = bucket.trim().to_string();
+    config.prefix = prefix.trim().trim_matches('/').to_string();
+    if config.prefix.is_empty() { config.prefix = DEFAULT_PREFIX.into(); }
+    config.device_name = device_name.chars().filter(|c| !c.is_control()).take(80).collect::<String>().trim().to_string();
+    if config.device_name.is_empty() { return Err("请填写设备名称".into()); }
+    if config.account_id.len() < 16 || !config.account_id.bytes().all(|b| b.is_ascii_hexdigit()) { return Err("Cloudflare Account ID 格式无效".into()); }
+    if config.bucket.is_empty() { return Err("请填写 R2 bucket 名称".into()); }
+    if !access_key_id.trim().is_empty() || !secret_access_key.trim().is_empty() {
+        if access_key_id.trim().is_empty() || secret_access_key.trim().is_empty() { return Err("Access Key ID 和 Secret Access Key 需要同时填写".into()); }
+        save_credentials(access_key_id.trim(), secret_access_key.trim())?;
+    }
+    let _ = credentials(&config)?;
+    save_config(&app, &config)?;
+    Ok(json!({"saved":true}))
+}
+
+#[tauri::command]
+pub fn sublens_device_disconnect(app: AppHandle) -> Result<Value, String> {
+    let mut config = load_config(&app)?;
+    delete_credentials()?;
+    config.account_id.clear();
+    config.bucket.clear();
+    save_config(&app, &config)?;
+    Ok(json!({"disconnected":true}))
+}
+
+#[tauri::command]
+pub async fn sublens_device_test_connection(app: AppHandle) -> Result<Value, String> {
+    let config = load_config(&app)?;
+    let creds = credentials(&config)?;
+    s3::test_connection(&creds).await.map_err(|e| e.to_string())?;
+    let (keys, _, _) = s3::list_objects_v2(&creds, &object_prefix(&config), None).await.map_err(|e| e.to_string())?;
+    Ok(json!({"connected":true,"objects":keys.len()}))
+}
+
+#[tauri::command]
+pub async fn sublens_device_create_bucket(app: AppHandle) -> Result<Value, String> {
+    let config = load_config(&app)?;
+    let creds = credentials(&config)?;
+    s3::create_bucket(&creds).await.map_err(|e| e.to_string())?;
+    Ok(json!({"created":true,"bucket":config.bucket}))
+}
+
+fn local_snapshot(state: &AppState, config: &DeviceConfig) -> Result<Value, String> {
+    let filters = LogFilters { app_type: Some("codex".into()), ..LogFilters::default() };
+    let first = state.db.get_request_logs(&filters, 0, 10_000).map_err(|e| e.to_string())?;
+    if first.total > MAX_RECORDS { return Err(format!("本机共有 {} 条记录，超过单设备快照上限 {}；请先缩短本机历史范围", first.total, MAX_RECORDS)); }
+    let mut logs = first.data;
+    let pages = (first.total as usize + 9_999) / 10_000;
+    for page in 1..pages {
+        logs.extend(state.db.get_request_logs(&filters, page as u32, 10_000).map_err(|e| e.to_string())?.data);
+    }
+    let records: Vec<Value> = logs.iter().map(usage_record).collect();
+    Ok(json!({"schema":SNAPSHOT_SCHEMA,"device":{"id":config.device_id,"label":config.device_name},"updatedAt":now(),"records":records}))
+}
+
+fn usage_record(row: &RequestLogDetail) -> Value {
+    let input = row.input_tokens as u64;
+    let output = row.output_tokens as u64;
+    let cached = row.cache_read_tokens as u64;
+    let write = row.cache_creation_tokens as u64;
+    json!({
+        "id":digest(&row.request_id),
+        "at":DateTime::<Utc>::from_timestamp(row.created_at,0).unwrap_or_else(Utc::now).to_rfc3339_opts(chrono::SecondsFormat::Millis,true),
+        "model":row.model.chars().take(200).collect::<String>(),"input":input,"cached":cached,"write":write,
+        "output":output,"total":input+output,
+        "costUsd":if row.status_code < 400 && row.pricing_model.as_deref().is_some_and(|p| !p.is_empty()) { row.total_cost_usd.parse::<f64>().ok().filter(|v| v.is_finite() && *v >= 0.0) } else { None },
+        "session":digest(row.request_id.split(':').nth(2).unwrap_or(&row.request_id))[..24].to_string()
+    })
+}
+
+fn validate_snapshot(value: &Value) -> Result<(String, String), String> {
+    if value["schema"].as_str() != Some(SNAPSHOT_SCHEMA) { return Err("设备快照版本不受支持".into()); }
+    let allowed_top = ["schema", "device", "updatedAt", "records"];
+    if value.as_object().is_none_or(|object| object.keys().any(|key| !allowed_top.contains(&key.as_str())) || allowed_top.iter().any(|key| !object.contains_key(*key))) {
+        return Err("设备快照字段无效".into());
+    }
+    let id = value["device"]["id"].as_str().unwrap_or_default();
+    let label = value["device"]["label"].as_str().unwrap_or_default();
+    if uuid::Uuid::parse_str(id).is_err() || label.is_empty() || label.len() > 320 { return Err("设备快照身份无效".into()); }
+    if value["device"].as_object().is_none_or(|object| object.len() != 2 || !object.contains_key("id") || !object.contains_key("label"))
+        || value["updatedAt"].as_str().and_then(|s| DateTime::parse_from_rfc3339(s).ok()).is_none() {
+        return Err("设备快照元数据无效".into());
+    }
+    let rows = value["records"].as_array().ok_or("设备快照记录无效")?;
+    if rows.len() > MAX_RECORDS as usize { return Err("设备快照记录数超出上限".into()); }
+    for row in rows {
+        let allowed_row = ["id", "at", "model", "input", "cached", "write", "output", "total", "costUsd", "session"];
+        if row.as_object().is_none_or(|object| object.keys().any(|key| !allowed_row.contains(&key.as_str()))
+            || allowed_row.iter().filter(|key| **key != "costUsd").any(|key| !object.contains_key(*key))) {
+            return Err("设备快照记录字段无效".into());
+        }
+        let input = row["input"].as_u64().unwrap_or(u64::MAX);
+        let cached = row["cached"].as_u64().unwrap_or(u64::MAX);
+        let write = row["write"].as_u64().unwrap_or(u64::MAX);
+        let output = row["output"].as_u64().unwrap_or(u64::MAX);
+        let total = row["total"].as_u64().unwrap_or(u64::MAX);
+        if row["id"].as_str().is_none_or(|s| s.len() != 64 || !s.bytes().all(|b| b.is_ascii_hexdigit()))
+            || row["at"].as_str().and_then(|s| DateTime::parse_from_rfc3339(s).ok()).is_none()
+            || row["model"].as_str().is_none_or(|s| s.len() > 200)
+            || row["session"].as_str().is_none_or(|s| s.len() != 24 || !s.bytes().all(|b| b.is_ascii_hexdigit()))
+            || ["input","cached","write","output","total"].iter().any(|key| row[*key].as_u64().is_none())
+            || cached.saturating_add(write) > input
+            || input.checked_add(output) != Some(total)
+            || row["costUsd"].as_f64().is_some_and(|v| !v.is_finite() || v < 0.0)
+        { return Err("设备快照中包含无效记录".into()); }
+    }
+    Ok((id.to_string(), label.to_string()))
+}
+
+fn persist_snapshot(db: &Connection, snapshot: &Value, etag: Option<&str>) -> Result<(), String> {
+    let (id, label) = validate_snapshot(snapshot)?;
+    let updated = snapshot["updatedAt"].as_str().unwrap_or("");
+    db.execute("INSERT INTO sl_cloud_devices(device_id,label,updated_at,synced_at,data,etag) VALUES(?1,?2,?3,?4,?5,?6) ON CONFLICT(device_id) DO UPDATE SET label=excluded.label,updated_at=excluded.updated_at,synced_at=excluded.synced_at,data=excluded.data,etag=COALESCE(excluded.etag,sl_cloud_devices.etag)",
+        params![id,label,updated,now(),snapshot.to_string(),etag]).map_err(|e| e.to_string())?;
+    Ok(())
+}
+
+#[tauri::command]
+pub async fn sublens_device_sync(app: AppHandle, state: State<'_, AppState>) -> Result<Value, String> {
+    let config = load_config(&app)?;
+    let creds = credentials(&config)?;
+    let db = database(&app)?;
+    let mut snapshot = local_snapshot(state.inner(), &config)?;
+    let previous_local: Option<String> = db.query_row("SELECT data FROM sl_cloud_devices WHERE device_id=?1", [&config.device_id], |r| r.get(0)).optional().map_err(|e| e.to_string())?;
+    let unchanged = previous_local.as_deref().and_then(|data| serde_json::from_str::<Value>(data).ok()).is_some_and(|old| old["device"]==snapshot["device"] && old["records"]==snapshot["records"]);
+    if unchanged { snapshot = serde_json::from_str(previous_local.as_deref().unwrap_or("{}")).map_err(|e| e.to_string())?; }
+    let local_bytes = serde_json::to_vec(&snapshot).map_err(|e| e.to_string())?;
+    if local_bytes.len() > MAX_OBJECT_BYTES { return Err("设备快照超过 24 MiB 上传上限".into()); }
+    let key_prefix = object_prefix(&config);
+    let local_key = format!("{}{}.json", key_prefix, config.device_id);
+    if !unchanged { s3::put_object(&creds, &local_key, local_bytes, "application/json").await.map_err(|e| e.to_string())?; }
+    persist_snapshot(&db, &snapshot, None)?;
+
+    let mut continuation: Option<String> = None;
+    let mut processed = 0usize;
+    let mut downloaded_bytes = 0usize;
+    loop {
+        let (keys, next, truncated) = s3::list_objects_v2(&creds, &key_prefix, continuation.as_deref()).await.map_err(|e| e.to_string())?;
+        for key in keys {
+            let Some(file) = key.strip_prefix(&key_prefix) else { continue; };
+            let Some(id) = file.strip_suffix(".json") else { continue; };
+            if uuid::Uuid::parse_str(id).is_err() { continue; }
+            processed += 1;
+            if processed > MAX_DEVICES { return Err(format!("前缀下设备文件超过 {MAX_DEVICES} 个，请清理旧设备文件")); }
+            if id == config.device_id { continue; }
+            let remote_etag = s3::head_object(&creds, &key).await.map_err(|e| e.to_string())?;
+            let cached_etag: Option<String> = db.query_row("SELECT etag FROM sl_cloud_devices WHERE device_id=?1", [id], |r| r.get(0)).optional().map_err(|e| e.to_string())?.flatten();
+            if remote_etag.is_some() && remote_etag == cached_etag {
+                db.execute("UPDATE sl_cloud_devices SET synced_at=?1 WHERE device_id=?2", params![now(),id]).map_err(|e| e.to_string())?;
+                continue;
+            }
+            if let Some((bytes, get_etag)) = s3::get_object(&creds, &key, MAX_OBJECT_BYTES).await.map_err(|e| e.to_string())? {
+                downloaded_bytes = downloaded_bytes.saturating_add(bytes.len());
+                if downloaded_bytes > MAX_SYNC_BYTES { return Err("本次同步下载的设备快照总量超过 128 MiB，请缩小设备目录或清理旧设备文件".into()); }
+                let remote: Value = serde_json::from_slice(&bytes).map_err(|e| format!("设备文件格式无效：{e}"))?;
+                if validate_snapshot(&remote).is_ok() && remote["device"]["id"].as_str() == Some(id) { persist_snapshot(&db, &remote, remote_etag.as_deref().or(get_etag.as_deref()))?; }
+            }
+        }
+        if !truncated { break; }
+        continuation = next;
+        if continuation.is_none() { return Err("R2 返回了不完整的设备列表".into()); }
+    }
+    Ok(json!({"synced":processed,"updatedAt":now()}))
+}
+
+fn aggregate_device(value: &Value) -> Value {
+    let records = value["records"].as_array().cloned().unwrap_or_default();
+    let tokens: u64 = records.iter().map(|r| r["total"].as_u64().unwrap_or(0)).sum();
+    let usd: f64 = records.iter().map(|r| r["costUsd"].as_f64().unwrap_or(0.0)).sum();
+    let sessions: std::collections::BTreeSet<&str> = records.iter().filter_map(|r| r["session"].as_str()).collect();
+    json!({"tokens":tokens,"usd":usd,"events":records.len(),"sessions":sessions.len()})
+}
+
+#[tauri::command(rename_all = "camelCase")]
+pub fn sublens_device_query(app: AppHandle, from: i64, to: i64, device_id: Option<String>) -> Result<Value, String> {
+    let config = load_config(&app)?;
+    let db = database(&app)?;
+    let mut stmt = db.prepare("SELECT data, synced_at FROM sl_cloud_devices ORDER BY label,device_id").map_err(|e| e.to_string())?;
+    let all: Vec<(Value,String)> = stmt.query_map([], |row| Ok((row.get::<_,String>(0)?,row.get::<_,String>(1)?))).map_err(|e| e.to_string())?.filter_map(Result::ok).filter_map(|(data,synced)| serde_json::from_str(&data).ok().map(|value|(value,synced))).collect();
+    let device_rows: Vec<Value> = all.iter().map(|(value,synced)| json!({"id":value["device"]["id"],"label":value["device"]["label"],"local":value["device"]["id"]==config.device_id,"lastSync":if synced.is_empty(){value["updatedAt"].as_str().unwrap_or("")}else{synced.as_str()},"summary":aggregate_device(value)})).collect();
+    let mut totals = (0u64,0u64,0u64,0u64,0f64,0u64,0u64);
+    let mut sessions = std::collections::BTreeSet::new();
+    let mut models = std::collections::BTreeMap::<String,(u64,f64,u64)>::new();
+    let mut days = std::collections::BTreeMap::<String,(u64,f64,u64)>::new();
+    let mut recent = Vec::new();
+    for (device,_) in &all {
+        if device_id.as_deref().is_some_and(|id| device["device"]["id"].as_str()!=Some(id)) { continue; }
+        let label = device["device"]["label"].as_str().unwrap_or("Device");
+        for row in device["records"].as_array().into_iter().flatten() {
+            let at = row["at"].as_str().unwrap_or("");
+            let epoch = DateTime::parse_from_rfc3339(at).map(|d| d.timestamp()).unwrap_or(0);
+            if epoch < from || epoch >= to { continue; }
+            let tok=row["total"].as_u64().unwrap_or(0);let output=row["output"].as_u64().unwrap_or(0);let cached=row["cached"].as_u64().unwrap_or(0);let cost=row["costUsd"].as_f64();
+            totals.0+=tok;totals.1+=cached;totals.2+=output;totals.3+=1;if let Some(cost)=cost{totals.4+=cost;totals.5+=tok;}else{totals.6+=1;}
+            if let Some(session) = row["session"].as_str() { sessions.insert(format!("{}:{session}",device["device"]["id"].as_str().unwrap_or_default())); }
+            let model=row["model"].as_str().unwrap_or("Unknown").to_string();let m=models.entry(model.clone()).or_default();m.0+=tok;m.1+=cost.unwrap_or(0.0);m.2+=1;
+            let day=at.get(..10).unwrap_or("unknown").to_string();let d=days.entry(day).or_default();d.0+=tok;d.1+=cost.unwrap_or(0.0);d.2+=1;
+            recent.push(json!({"id":row["id"],"at":at,"project":label,"model":model,"total":tok,"cached":cached,"output":output,"price":{"amount":cost,"usd":cost.unwrap_or(0.0)}}));
+        }
+    }
+    recent.sort_by(|a,b| b["at"].as_str().cmp(&a["at"].as_str()));recent.truncate(100);
+    Ok(json!({"devices":device_rows,"summary":{"tokens":totals.0,"cached":totals.1,"output":totals.2,"events":totals.3,"sessions":sessions.len(),"usd":totals.4,"pricedTokens":totals.5,"unpriced":totals.6},
+        "models":models.into_iter().map(|(model,(tokens,usd,events))|json!({"model":model,"tokens":tokens,"usd":usd,"events":events})).collect::<Vec<_>>(),
+        "days":days.into_iter().map(|(date,(tokens,usd,events))|json!({"date":date,"tokens":tokens,"usd":usd,"events":events})).collect::<Vec<_>>(),"rows":recent}))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{usage_record, valid_bucket, validate_snapshot, SNAPSHOT_SCHEMA};
+    use crate::services::usage_stats::RequestLogDetail;
+    use serde_json::json;
+
+    fn log() -> RequestLogDetail {
+        RequestLogDetail {
+            request_id: "codex_session:thread-v1:private-thread-id:1".into(), provider_id: "codex".into(),
+            provider_name: Some("OpenAI".into()), app_type: "codex".into(), model: "gpt-5.6-sol".into(),
+            request_model: Some("gpt-5.6-sol".into()), cost_multiplier: "1".into(), input_tokens: 120,
+            output_tokens: 30, cache_read_tokens: 40, cache_creation_tokens: 0, input_token_semantics: 0,
+            input_cost_usd: "0.01".into(), output_cost_usd: "0.02".into(), cache_read_cost_usd: "0".into(),
+            cache_creation_cost_usd: "0".into(), total_cost_usd: "0.03".into(), is_streaming: false,
+            latency_ms: 10, first_token_ms: None, duration_ms: None, status_code: 200, error_message: None,
+            created_at: 1_750_000_000, data_source: Some("codex_session".into()), pricing_model: Some("gpt-5.6-sol".into()),
+        }
+    }
+
+    #[test]
+    fn snapshot_record_is_allowlisted_and_anonymizes_identifiers() {
+        let row = log();
+        let value = usage_record(&row);
+        assert_eq!(value["id"].as_str().unwrap().len(), 64);
+        assert_ne!(value["session"], "private-thread-id");
+        let serialized = value.to_string();
+        for forbidden in ["private-thread-id", "request_id", "provider_id", "error_message", "error_message", "projectDir", "chat"] {
+            assert!(!serialized.contains(forbidden));
+        }
+        assert_eq!(value["total"], 150);
+    }
+
+    #[test]
+    fn only_valid_sublens_device_snapshots_are_accepted() {
+        let id = uuid::Uuid::new_v4().to_string();
+        let mut snapshot = json!({"schema":SNAPSHOT_SCHEMA,"device":{"id":id,"label":"Workstation"},"updatedAt":"2026-09-24T12:00:00Z","records":[usage_record(&log())]});
+        assert!(validate_snapshot(&snapshot).is_ok());
+        snapshot["records"][0]["total"] = json!(999);
+        assert!(validate_snapshot(&snapshot).is_err());
+        snapshot["records"][0]["total"] = json!(150);
+        snapshot["records"][0]["chatBody"] = json!("must not pass through");
+        assert!(validate_snapshot(&snapshot).is_err());
+    }
+
+    #[test]
+    fn r2_bucket_names_are_restricted_to_safe_dns_labels() {
+        assert!(valid_bucket("sublens-usage-2026"));
+        assert!(!valid_bucket("-sublens"));
+        assert!(!valid_bucket("Sublens"));
+        assert!(!valid_bucket("sub/lens"));
+    }
+}
