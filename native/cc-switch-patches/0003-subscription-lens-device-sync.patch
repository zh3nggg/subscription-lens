+#[tauri::command(rename_all="camelCase")]
+pub fn sublens_monitor_add_source(app: AppHandle, kind: String, path: String) -> Result<Value,String> {
+    if !KINDS.contains(&kind.as_str()) { return Err("仅支持 CodeBuddy 和 Qoder".into()); }
+    let (_,mut db)=app_db(&app)?; let source=ensure_source(&db,&kind,&path)?;
+    let id=source["id"].as_str().unwrap_or("").to_owned(); let root=PathBuf::from(source["path"].as_str().unwrap_or(""));
+    let (imported,invalid,files)=scan_source(&mut db,&id,&kind,&root)?;
+    db.execute("UPDATE sl_monitor_sources SET state='ready',last_at=?2,invalid=?3,files=?4 WHERE id=?1",params![id,now_iso(),invalid as i64,files as i64]).map_err(|e|e.to_string())?;
+    Ok(json!({"source":source,"imported":imported,"invalid":invalid,"files":files}))
+}
