+//! Local, read-only usage collectors for Subscription Lens.
+//!
+//! This module deliberately reads only CodeBuddy and Qoder usage logs. It
+//! extracts token/latency/cost metadata and never stores raw log lines.
+
+use chrono::{DateTime, NaiveDateTime, Utc};
+use rusqlite::{params, Connection, OptionalExtension};
+use serde_json::{json, Map, Value};
+use sha2::{Digest, Sha256};
+use std::{
+    collections::{BTreeMap, BTreeSet},
+    fs::{self, File},
+    io::{BufRead, BufReader},
+    path::{Path, PathBuf},
+    time::UNIX_EPOCH,
+};
+use tauri::{AppHandle, Manager};
+
+const KINDS: [&str; 2] = ["codebuddy", "qoder"];
+const MAX_DEPTH: usize = 10;
+const MAX_FILES: usize = 25_000;
+const MAX_LINE: usize = 8 * 1024 * 1024;
+
+fn app_db(app: &AppHandle) -> Result<(PathBuf, Connection), String> {
+    let dir = app.path().app_data_dir().map_err(|e| e.to_string())?;
+    fs::create_dir_all(&dir).map_err(|e| format!("创建用量数据目录失败：{e}"))?;
+    let path = dir.join("usage-monitor.sqlite3");
+    let db = Connection::open(&path).map_err(|e| format!("打开用量数据库失败：{e}"))?;
+    db.busy_timeout(std::time::Duration::from_secs(2)).map_err(|e| e.to_string())?;
+    db.execute_batch(
+        "PRAGMA journal_mode=WAL;
+         CREATE TABLE IF NOT EXISTS sl_monitor_sources(
+           id TEXT PRIMARY KEY, kind TEXT NOT NULL, path TEXT NOT NULL UNIQUE COLLATE NOCASE,
+           enabled INTEGER NOT NULL DEFAULT 1, state TEXT NOT NULL DEFAULT 'idle',
+           last_at TEXT, invalid INTEGER NOT NULL DEFAULT 0, files INTEGER NOT NULL DEFAULT 0
+         );
+         CREATE TABLE IF NOT EXISTS sl_monitor_events(
+           source_id TEXT NOT NULL, event_id TEXT NOT NULL, at TEXT NOT NULL,
+           provider TEXT NOT NULL, model TEXT NOT NULL, file_path TEXT NOT NULL DEFAULT '', data TEXT NOT NULL,
+           PRIMARY KEY(source_id,event_id)
+         );
+         PRAGMA user_version=1;
+         CREATE INDEX IF NOT EXISTS sl_monitor_time ON sl_monitor_events(at);
+         CREATE TABLE IF NOT EXISTS sl_monitor_files(
+           source_id TEXT NOT NULL, path TEXT NOT NULL, size INTEGER NOT NULL, modified INTEGER NOT NULL,
+           PRIMARY KEY(source_id,path)
+         );
+         CREATE TABLE IF NOT EXISTS sl_monitor_rates(
+           provider TEXT NOT NULL, model TEXT NOT NULL, rates TEXT NOT NULL,
+           PRIMARY KEY(provider,model)
+         );",
+    ).map_err(|e| format!("初始化用量数据库失败：{e}"))?;
+    let event_columns: BTreeSet<String> = {
+        let mut stmt = db.prepare("PRAGMA table_info(sl_monitor_events)").map_err(|e| e.to_string())?;
+        let rows = stmt.query_map([], |r| r.get::<_, String>(1)).map_err(|e| e.to_string())?.filter_map(Result::ok).collect(); rows
+    };
+    if !event_columns.contains("file_path") {
+        db.execute("ALTER TABLE sl_monitor_events ADD COLUMN file_path TEXT NOT NULL DEFAULT ''", []).map_err(|e| e.to_string())?;
+    }
+    Ok((path, db))
+}
+
+fn home() -> Option<PathBuf> {
+    #[cfg(windows)]
+    { std::env::var_os("USERPROFILE").map(PathBuf::from) }
+    #[cfg(not(windows))]
+    { std::env::var_os("HOME").map(PathBuf::from) }
+}
+
+fn default_path(kind: &str) -> Result<PathBuf, String> {
+    if !KINDS.contains(&kind) { return Err("仅支持 CodeBuddy 和 Qoder".into()); }
+    if kind == "qoder" {
+        if let Some(path) = std::env::var_os("QODER_CONFIG_DIR") { return Ok(PathBuf::from(path)); }
+    }
+    home().map(|h| h.join(if kind == "qoder" { ".qoder" } else { ".codebuddy" }))
+        .ok_or_else(|| "无法确定用户目录".into())
+}
+
+fn id_for(kind: &str, path: &Path) -> String {
+    let mut h = Sha256::new(); h.update(kind.as_bytes()); h.update([0]); h.update(path.to_string_lossy().as_bytes());
+    format!("{:x}", h.finalize())[..24].to_string()
+}
+
+fn now_iso() -> String { Utc::now().to_rfc3339_opts(chrono::SecondsFormat::Millis, true) }
+fn as_u64(v: Option<&Value>) -> Option<u64> { v?.as_u64() }
+fn first<'a>(v: &'a Value, keys: &[&str]) -> Option<&'a Value> { keys.iter().find_map(|k| v.get(*k)) }
+fn text(v: Option<&Value>) -> Option<String> { v.and_then(Value::as_str).map(str::trim).filter(|s| !s.is_empty()).map(str::to_owned) }
+
+fn timestamp(v: Option<&Value>, line: Option<&str>) -> Option<String> {
+    if let Some(value) = text(v) {
+        if let Ok(dt) = DateTime::parse_from_rfc3339(&value) { return Some(dt.with_timezone(&Utc).to_rfc3339_opts(chrono::SecondsFormat::Millis, true)); }
+        for fmt in ["%Y-%m-%d %H:%M:%S%.f", "%Y-%m-%dT%H:%M:%S%.f"] {
+            if let Ok(dt) = NaiveDateTime::parse_from_str(&value, fmt) { return Some(dt.and_utc().to_rfc3339_opts(chrono::SecondsFormat::Millis, true)); }
+        }
+    }
+    let line = line?;
+    let prefix = line.get(..line.len().min(35))?;
+    for fmt in ["%Y-%m-%d %H:%M:%S%.f", "%Y-%m-%dT%H:%M:%S%.f"] {
+        if let Ok(dt) = NaiveDateTime::parse_from_str(prefix, fmt) { return Some(dt.and_utc().to_rfc3339_opts(chrono::SecondsFormat::Millis, true)); }
+    }
+    None
+}
+
+fn safe_label(value: Option<String>, fallback: &str) -> String {
+    let s = value.unwrap_or_else(|| fallback.to_owned());
+    s.chars().filter(|c| !c.is_control()).take(180).collect()
+}
+
+fn canonical(raw: &Value, kind: &str, source_path: &Path, line_no: u64, line_stamp: Option<&str>) -> Option<Value> {
+    let mut obj = raw;
+    if kind == "qoder" {
+        if raw.get("type").and_then(Value::as_str).is_some_and(|t| t == "result" || t == "system") { return None; }
+        if raw.get("usedTokens").and_then(Value::as_u64).is_some() {
+            let session = text(first(raw, &["sessionId", "session_id"]))?;
+            let used = as_u64(raw.get("usedTokens"))?;
+            let at = timestamp(first(raw, &["timestamp", "created_at", "at"]), line_stamp)?;
+            return Some(json!({
+                "id": format!("quest-context:{session}"), "at": at, "provider":"Qoder", "model":"Qoder Quest",
+                "session":session, "project":"Qoder Quest", "input":used, "cached":0, "write":0,
+                "output":0, "reasoning":0, "total":used, "tokenBasis":"estimated", "status":null,
+                "latencyMs":null, "ttftMs":null, "amount":null, "usd":null, "sourceAmount":null,
+                "sourceUnit":"Credits", "basis":"estimate", "origin":"qoder-quest-context", "pricingModel":"Qoder Quest"
+            }));
+        }
+        obj = raw.get("message").and_then(|m| m.get("message")).or_else(|| raw.get("message")).unwrap_or(raw);
+    }
+    let usage = if kind == "codebuddy" {
+        raw.pointer("/providerData/rawUsage").or_else(|| raw.pointer("/message/usage"))
+    } else {
+        first(obj, &["usage"]).or_else(|| first(raw, &["usage"]))
+            .or_else(|| raw.pointer("/data/usage"))
+    }?;
+    let (input, cached, write, output, reasoning) = if kind == "codebuddy" && raw.pointer("/providerData/rawUsage").is_some() {
+        let hit = as_u64(first(usage, &["prompt_cache_hit_tokens"]))
+            .or_else(|| usage.pointer("/prompt_tokens_details/cached_tokens").and_then(Value::as_u64)).unwrap_or(0);
+        let write = as_u64(first(usage, &["prompt_cache_write_tokens"])).unwrap_or(0);
+        let prompt = as_u64(first(usage, &["prompt_tokens"]));
+        let miss = as_u64(first(usage, &["prompt_cache_miss_tokens"])).or_else(|| prompt.map(|p| p.saturating_sub(hit + write)))?;
+        let output = as_u64(first(usage, &["completion_tokens"]))?;
+        let reasoning = as_u64(first(usage, &["completion_thinking_tokens"])).unwrap_or(0);
+        (miss.saturating_add(hit).saturating_add(write), hit, write, output, reasoning)
+    } else {
+        let input = as_u64(first(usage, &["input_tokens", "inputTokens", "prompt_tokens"]))?;
+        let cached = as_u64(first(usage, &["cache_read_input_tokens", "cacheReadInputTokens", "cached_tokens"])).unwrap_or(0);
+        let write = as_u64(first(usage, &["cache_creation_input_tokens", "cacheCreationInputTokens", "cache_write_input_tokens"])).unwrap_or(0);
+        let output = as_u64(first(usage, &["output_tokens", "outputTokens", "completion_tokens"]))?;
+        let reasoning = as_u64(first(usage, &["reasoning_tokens", "reasoningTokens", "reasoning_output_tokens"])).unwrap_or(0);
+        (input, cached, write, output, reasoning)
+    };
+    if cached.saturating_add(write) > input || reasoning > output { return None; }
+    let model = safe_label(
+        text(first(obj, &["model"]))
+            .or_else(|| text(raw.pointer("/providerData/model")))
+            .or_else(|| text(raw.pointer("/message/model")))
+            .or_else(|| text(first(raw, &["model"]))),
+        "unknown",
+    );
+    let provider = if kind == "codebuddy" { "CodeBuddy" } else { "Qoder" };
+    let session = safe_label(text(first(raw, &["sessionId", "session_id"]))
+        .or_else(|| text(raw.pointer("/data/session_id"))), source_path.file_stem()?.to_string_lossy().as_ref());
+    let project = source_path.parent().and_then(Path::file_name).map(|s| s.to_string_lossy().into_owned()).unwrap_or_else(|| provider.to_owned());
+    let at = timestamp(first(raw, &["timestamp", "created_at", "at"]).or_else(|| first(obj, &["timestamp"])), line_stamp)?;
+    let supplied_id = text(first(obj, &["id", "messageId"]))
+        .or_else(|| text(first(raw, &["id"])))
+        .or_else(|| text(raw.pointer("/providerData/messageId")));
+    let stable_id = supplied_id.unwrap_or_else(|| format!("{}:{}:{}:{}:{}", source_path.display(), line_no, at, model, input + output));
+    let mut h = Sha256::new(); h.update(stable_id.as_bytes()); let id = format!("{:x}", h.finalize());
+    let credits = first(usage, &["credits", "original_credits"]).or_else(|| first(raw, &["credits", "original_credits"]));
+    let credits_scaled = credits.and_then(|v| v.as_f64().or_else(|| v.as_str()?.parse::<f64>().ok()))
+        .filter(|v| v.is_finite() && *v >= 0.0 && *v <= 1.0e12)
+        .map(|v| format!("{:.0}", v * 1.0e15));
+    let mut event = Map::new();
+    event.insert("id".into(), json!(id)); event.insert("at".into(), json!(at)); event.insert("provider".into(), json!(provider));
+    event.insert("model".into(), json!(model)); event.insert("session".into(), json!(session)); event.insert("project".into(), json!(project));
+    event.insert("input".into(), json!(input)); event.insert("cached".into(), json!(cached)); event.insert("write".into(), json!(write));
+    event.insert("output".into(), json!(output)); event.insert("reasoning".into(), json!(reasoning)); event.insert("total".into(), json!(input.saturating_add(output)));
+    event.insert("tokenBasis".into(), json!("measured")); event.insert("status".into(), first(raw, &["status", "statusCode"]).cloned().unwrap_or(Value::Null));
+    event.insert("latencyMs".into(), first(raw, &["latencyMs"]).cloned().unwrap_or(Value::Null)); event.insert("ttftMs".into(), first(raw, &["ttftMs", "firstTokenMs"]).cloned().unwrap_or(Value::Null));
+    event.insert("amount".into(), Value::Null); event.insert("usd".into(), Value::Null); event.insert("sourceAmount".into(), credits_scaled.map(Value::String).unwrap_or(Value::Null));
+    event.insert("sourceUnit".into(), json!(if kind == "qoder" { "Credits" } else { "" }));
+    event.insert("basis".into(), json!("estimate"));
+    event.insert("origin".into(), json!(if kind == "qoder" { "qoder-cli" } else { "codebuddy-code" }));
+    event.insert("pricingModel".into(), json!(model));
+    Some(Value::Object(event))
+}
