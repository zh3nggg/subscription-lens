+fn rate_amount(event: &Value, rates: Option<&Value>) -> Option<f64> {
+    let rates=rates?; let categories=[("input",event["input"].as_f64()?.max(0.0)-event["cached"].as_f64()?.max(0.0)-event["write"].as_f64()?.max(0.0)),("cached",event["cached"].as_f64()?), ("write",event["write"].as_f64()?), ("output",event["output"].as_f64()?)];
+    Some(categories.iter().map(|(k,n)| n* rates[*k].as_str().and_then(|v|v.parse::<f64>().ok()).unwrap_or(0.0)/1_000_000.0).sum())
+}
