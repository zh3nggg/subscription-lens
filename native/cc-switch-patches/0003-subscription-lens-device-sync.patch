+fn candidates(kind: &str) -> Vec<PathBuf> {
+    let Ok(primary) = default_path(kind) else { return Vec::new(); };
+    let mut paths = vec![primary];
+    if kind == "qoder" {
+        if let Some(appdata) = std::env::var_os("APPDATA") { paths.push(PathBuf::from(appdata).join("Qoder").join("logs")); }
+    }
+    paths.into_iter().filter_map(|p| fs::canonicalize(&p).ok()).filter(|p| p.is_dir()).collect()
+}
+
+fn discover(db: &Connection) -> Result<Vec<Value>, String> {
+    let connected: Vec<(String,String)> = {
+        let mut stmt = db.prepare("SELECT kind,path FROM sl_monitor_sources") .map_err(|e| e.to_string())?;
+        let rows = stmt.query_map([], |r| Ok((r.get::<_,String>(0)?,r.get::<_,String>(1)?))).map_err(|e| e.to_string())?.filter_map(Result::ok).collect(); rows
+    };
+    let mut found = Vec::new();
+    for kind in KINDS { if let Some(path) = candidates(kind).into_iter().next() {
+        let candidate = path.to_string_lossy().to_lowercase();
+        let is_connected = connected.iter().any(|(stored_kind,stored_path)| stored_path.to_lowercase()==candidate || (kind=="qoder" && stored_kind=="qoder"));
+        found.push(json!({"kind":kind,"path":path.to_string_lossy(),"connected":is_connected}));
+    }}
+    Ok(found)
+}
+
+fn collect_files(root: &Path, kind: &str) -> Vec<PathBuf> {
+    fn visit(root: &Path, dir: &Path, kind: &str, depth: usize, out: &mut Vec<PathBuf>) {
+        if depth > MAX_DEPTH || out.len() >= MAX_FILES { return; }
+        let Ok(entries) = fs::read_dir(dir) else { return; };
+        for entry in entries.flatten() {
+            if out.len() >= MAX_FILES { break; }
+            let path = entry.path(); let Ok(ft) = entry.file_type() else { continue; };
+            if ft.is_symlink() { continue; }
+            if ft.is_dir() { visit(root, &path, kind, depth + 1, out); }
+            else if ft.is_file() {
+                let name = entry.file_name().to_string_lossy().to_string();
+                let yes = if kind == "codebuddy" {
+                    name.to_lowercase().ends_with(".jsonl") && !path.components().any(|c| c.as_os_str().to_string_lossy().eq_ignore_ascii_case("tool-results"))
+                        && (root.file_name().is_some_and(|s| s.to_string_lossy().eq_ignore_ascii_case("projects")) || path.starts_with(root.join("projects")))
+                } else {
+                    let lower = name.to_lowercase();
+                    ["qodercli.log","agent.log","quest.log","renderer.log","subscription-lens.jsonl"].contains(&lower.as_str())
+                        || (lower.starts_with("usage") && lower.ends_with(".jsonl")) || (lower.starts_with("events") && lower.ends_with(".jsonl"))
+                };
+                if yes { out.push(path); }
+            }
+        }
+        let _ = root;
+    }
+    let mut out = Vec::new(); visit(root, root, kind, 0, &mut out); out.sort(); out
+}
+
+fn scan_source(db: &mut Connection, id: &str, kind: &str, root: &Path) -> Result<(u64, u64, u64), String> {
+    let roots = if kind == "qoder" { let mut r = vec![root.to_path_buf()]; if let Some(appdata) = std::env::var_os("APPDATA") { let q = PathBuf::from(appdata).join("Qoder").join("logs"); if q.is_dir() && q != root { r.push(q); }} r } else { vec![root.to_path_buf()] };
+    let files: Vec<_> = roots.iter().flat_map(|r| collect_files(r, kind)).collect();
+    let seen: BTreeSet<String> = files.iter().map(|p| p.to_string_lossy().to_string()).collect();
+    let mut imported = 0; let mut invalid = 0; let mut unchanged = 0;
+    for path in &files {
+        let Ok(meta) = fs::metadata(path) else { continue; };
+        let size = meta.len(); let modified = meta.modified().ok().and_then(|m| m.duration_since(UNIX_EPOCH).ok()).map(|d| d.as_millis() as i64).unwrap_or(0);
+        let file_key = path.to_string_lossy().to_string();
+        let old: Option<(i64,i64)> = db.query_row("SELECT size,modified FROM sl_monitor_files WHERE source_id=?1 AND path=?2", params![id,file_key], |r| Ok((r.get(0)?,r.get(1)?))).optional().map_err(|e| e.to_string())?;
+        if old == Some((size as i64, modified)) { unchanged += 1; continue; }
+        let f = match File::open(path) { Ok(f) => f, Err(_) => { invalid += 1; continue; } };
+        let tx = db.transaction().map_err(|e| e.to_string())?;
+        if old.is_some() {
+            tx.execute("DELETE FROM sl_monitor_events WHERE source_id=?1 AND file_path=?2", params![id,file_key]).map_err(|e|e.to_string())?;
+        }
+        let reader = BufReader::new(f); let mut consumed = 0u64;
+        for (index, line) in reader.split(b'\n').enumerate() {
+            let Ok(bytes) = line else { invalid += 1; continue; }; consumed += bytes.len() as u64 + 1;
+            if bytes.len() > MAX_LINE { invalid += 1; continue; }
+            let text_line = String::from_utf8_lossy(&bytes);
+            let stamp = text_line.get(..19).filter(|s| s.as_bytes().get(4)==Some(&b'-'));
+            let parsed = if kind == "qoder" {
+                let start = text_line.find('{').unwrap_or(usize::MAX);
+                if start == usize::MAX { None } else { serde_json::from_str::<Value>(&text_line[start..]).ok() }
+            } else { serde_json::from_str::<Value>(&text_line).ok() };
+            let Some(raw) = parsed else { continue; };
+            if let Some(event) = canonical(&raw, kind, path, index as u64, stamp) {
+                let at = event["at"].as_str().unwrap_or(""); let provider = event["provider"].as_str().unwrap_or(""); let model = event["model"].as_str().unwrap_or("");
+                let event_id = event["id"].as_str().unwrap_or("");
+                imported += tx.execute("INSERT INTO sl_monitor_events(source_id,event_id,at,provider,model,file_path,data) VALUES(?1,?2,?3,?4,?5,?6,?7) ON CONFLICT(source_id,event_id) DO UPDATE SET at=excluded.at,provider=excluded.provider,model=excluded.model,file_path=excluded.file_path,data=excluded.data WHERE data<>excluded.data", params![id,event_id,at,provider,model,path.to_string_lossy(),event.to_string()]).unwrap_or(0) as u64;
+            } else {
+                let looks_like_usage = if kind == "codebuddy" {
+                    raw.pointer("/providerData/rawUsage").is_some() || raw.pointer("/message/usage").is_some()
+                } else {
+                    raw.get("usedTokens").is_some() || raw.get("usage").is_some() || raw.pointer("/data/usage").is_some()
+                };
+                if looks_like_usage { invalid += 1; }
+            }
+        }
+        tx.execute("INSERT INTO sl_monitor_files(source_id,path,size,modified) VALUES(?1,?2,?3,?4) ON CONFLICT(source_id,path) DO UPDATE SET size=excluded.size,modified=excluded.modified", params![id,file_key,size as i64,modified]).map_err(|e| e.to_string())?;
+        tx.commit().map_err(|e| e.to_string())?;
+        let _ = consumed;
+    }
+    // Drop events/checkpoints for files the user removed from these source folders.
+    let stored: Vec<String> = { let mut stmt=db.prepare("SELECT path FROM sl_monitor_files WHERE source_id=?1").map_err(|e|e.to_string())?; let rows=stmt.query_map([id],|r|r.get(0)).map_err(|e|e.to_string())?.filter_map(Result::ok).collect(); rows };
+    for old in stored { if !seen.contains(&old) { db.execute("DELETE FROM sl_monitor_files WHERE source_id=?1 AND path=?2",params![id,old]).ok(); db.execute("DELETE FROM sl_monitor_events WHERE source_id=?1 AND file_path=?2",params![id,old]).ok(); } }
+    db.execute("DELETE FROM sl_monitor_events WHERE source_id=?1 AND NOT EXISTS (SELECT 1 FROM sl_monitor_files f WHERE f.source_id=sl_monitor_events.source_id)",params![id]).ok();
+    let _ = unchanged;
+    Ok((imported, invalid, files.len() as u64))
+}
+
+fn ensure_source(db: &Connection, kind: &str, raw_path: &str) -> Result<Value, String> {
+    if !KINDS.contains(&kind) { return Err("仅支持 CodeBuddy 和 Qoder".into()); }
+    let path = fs::canonicalize(raw_path).map_err(|e| format!("无法读取来源目录：{e}"))?;
+    if !path.is_dir() { return Err("来源必须是文件夹".into()); }
+    let id = id_for(kind,&path);
+    db.execute("INSERT OR IGNORE INTO sl_monitor_sources(id,kind,path,enabled,state) VALUES(?1,?2,?3,1,'idle')",params![id,kind,path.to_string_lossy()]).map_err(|e| format!("保存来源失败：{e}"))?;
+    Ok(json!({"id":id,"kind":kind,"path":path,"enabled":true}))
+}
