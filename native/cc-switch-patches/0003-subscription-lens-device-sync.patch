+/// Create a bucket on S3-compatible services that expose CreateBucket.
+pub(crate) async fn create_bucket(creds: &S3Credentials) -> Result<(), AppError> {
+    let url_str = build_bucket_url(creds);
+    let url = Url::parse(&url_str).map_err(|e| {
+        AppError::localized("s3.url.invalid", format!("S3 URL 无效: {e}"), format!("Invalid S3 URL: {e}"))
+    })?;
+    let body = format!("<CreateBucketConfiguration xmlns=\"http://s3.amazonaws.com/doc/2006-03-01/\"><LocationConstraint>{}</LocationConstraint></CreateBucketConfiguration>", creds.region);
+    let client = http_client::get();
+    let mut headers = reqwest::header::HeaderMap::new();
+    headers.insert("content-type", "application/xml".parse().unwrap());
+    sign_request("PUT", &url, &mut headers, &sha256_hex(body.as_bytes()), creds, chrono::Utc::now());
+    let response = client.put(url.as_str()).headers(headers).body(body).timeout(Duration::from_secs(DEFAULT_TIMEOUT_SECS)).send().await
+        .map_err(|e| s3_transport_error("s3.create_bucket_failed", "创建存储桶", "create bucket", &e))?;
+    if response.status().is_success() { return Ok(()); }
+    Err(s3_status_error("CreateBucket", response.status(), &url_str))
+}
