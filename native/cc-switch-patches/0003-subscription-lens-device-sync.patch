+pub fn sublens_monitor_set_rate(app: AppHandle, provider: String, model: String, rates: Value) -> Result<bool,String> {
+    let (_,db)=app_db(&app)?; let provider=provider.trim(); let model=model.trim();
+    if provider.is_empty()||model.is_empty()||provider.len()>180||model.len()>180 { return Err("供应商和模型不能为空".into()); }
+    let mut normalized=Map::new();
+    for key in ["input","cached","write","output"] { let raw=rates.get(key).and_then(Value::as_str).or_else(||rates.get(key).map(Value::as_f64).map(|_| "0")).unwrap_or("0"); let number=raw.parse::<f64>().map_err(|_|"价格格式无效")?; if !number.is_finite()||number<0.0||number>1_000_000.0{return Err("价格超出范围".into());} normalized.insert(key.into(),json!(raw)); }
+    db.execute("INSERT INTO sl_monitor_rates(provider,model,rates) VALUES(?1,?2,?3) ON CONFLICT(provider,model) DO UPDATE SET rates=excluded.rates",params![provider,model,Value::Object(normalized).to_string()]).map_err(|e|e.to_string())?; Ok(true)
+}
