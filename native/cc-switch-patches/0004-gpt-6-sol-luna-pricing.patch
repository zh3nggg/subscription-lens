+    /// OpenAI applies the long-context tier to the entire request once input
+    /// exceeds 272K tokens. Preserve user overrides by switching tiers only
+    /// when the stored row still equals the bundled Standard short-context row.
+    pub fn for_context(&self, model: Option<&str>, input_tokens: u64) -> Self {
+        if input_tokens <= 272_000 {
+            return self.clone();
+        }
+        let mut id = model.unwrap_or_default().trim().to_ascii_lowercase();
+        if let Some(last) = id.rsplit('/').next() {
+            id = last.split('@').next().unwrap_or(last).to_string();
+        }
+        for suffix in ["-minimal", "-low", "-medium", "-high", "-xhigh"] {
+            if let Some(base) = id.strip_suffix(suffix) {
+                id = base.to_string();
+                break;
+            }
+        }
+        let tiers = match id.as_str() {
+            "gpt-6-astra" => Some((("10", "50", "1", "12.5"), ("20", "75", "2", "25"))),
+            "gpt-6-sol" => Some((("2", "10", "0.2", "2.5"), ("4", "15", "0.4", "5"))),
+            "gpt-6-luna" => Some((
+                ("0.1", "0.5", "0.01", "0.125"),
+                ("0.2", "0.75", "0.02", "0.25"),
+            )),
+            _ => None,
+        };
+        let Some((short, long)) = tiers else {
+            return self.clone();
+        };
+        let short =
+            Self::from_strings(short.0, short.1, short.2, short.3).expect("valid bundled pricing");
+        if self.input_cost_per_million != short.input_cost_per_million
+            || self.output_cost_per_million != short.output_cost_per_million
+            || self.cache_read_cost_per_million != short.cache_read_cost_per_million
+            || self.cache_creation_cost_per_million != short.cache_creation_cost_per_million
+        {
+            return self.clone();
+        }
+        Self::from_strings(long.0, long.1, long.2, long.3).expect("valid bundled pricing")
+    }
 }
 
