+/// Subscription Lens embeds the CC Switch proxy but must keep ChatGPT-login
+/// clients on official Codex model IDs.  Resolve those client-safe aliases to
+/// their provider models before the catalog guard preserves an alias verbatim.
+/// The field is optional, scoped to this embedding, and leaves CC Switch's
+/// existing provider catalog behavior unchanged for every other caller.
+fn codex_alias_mapping(provider: &Provider, request_model: &str) -> Option<String> {
+    provider
+        .settings_config
+        .get("codexAliasMappings")
+        .and_then(|mappings| mappings.as_array())
+        .and_then(|mappings| mappings.iter().find_map(|mapping| {
+            let alias = mapping.get("alias").and_then(|value| value.as_str())?.trim();
+            let upstream = mapping.get("upstream").and_then(|value| value.as_str())?.trim();
+            (alias == request_model && !upstream.is_empty()).then(|| upstream.to_string())
+        }))
+}
