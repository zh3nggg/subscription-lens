+#[tauri::command]
+fn open_sublens_provider_manager(app: tauri::AppHandle) -> Result<(), String> {
+    #[cfg(feature = "sublens-host")]
+    {
+        if let Some(window) = app.get_webview_window("sublens-provider-manager") {
+            let _ = window.show();
+            let _ = window.unminimize();
+            let _ = window.set_focus();
+            return Ok(());
+        }
+
+        tauri::WebviewWindowBuilder::new(
+            &app,
+            "sublens-provider-manager",
+            tauri::WebviewUrl::App("ccswitch/index.html".into()),
+        )
+        .initialization_script(
+            r#"try {
+                localStorage.setItem("cc-switch-last-app", "codex");
+                localStorage.setItem("cc-switch-last-view", "providers");
+            } catch (_) {}"#,
+        )
+        .title("Subscription Lens · 供应商管理")
+        .inner_size(1120.0, 800.0)
+        .min_inner_size(900.0, 640.0)
+        .resizable(true)
+        .build()
+        .map(|_| ())
+        .map_err(|error| format!("无法打开供应商管理器: {error}"))
+    }
+
+    #[cfg(not(feature = "sublens-host"))]
+    {
+        let _ = app;
+        Err("Subscription Lens provider manager is unavailable in this build".to_string())
+    }
+}
+
