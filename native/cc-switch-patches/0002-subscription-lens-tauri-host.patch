diff --git a/src/components/usage/SubscriptionLensDashboard.tsx b/src/components/usage/SubscriptionLensDashboard.tsx
new file mode 100644
index 00000000..ba55af66
--- /dev/null
+++ b/src/components/usage/SubscriptionLensDashboard.tsx
@@ -0,0 +1,254 @@
+import { invoke } from "@tauri-apps/api/core";
+import { useQuery } from "@tanstack/react-query";
+import { useMemo } from "react";
+import { useTranslation } from "react-i18next";
+import { UsageDashboard } from "./UsageDashboard";
+import {
+  useModelStats,
+  useProviderStats,
+  useUsageSummary,
+} from "@/lib/query/usage";
+import type { UsageRangeSelection } from "@/types/usage";
+import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
+
+interface CodexQuotaTier {
+  name: string;
+  utilization: number;
+  resetsAt?: string | null;
+}
+
+interface CodexQuotaResult {
+  success: boolean;
+  tiers?: CodexQuotaTier[];
+}
+
+interface SubscriptionLensDashboardProps {
+  refreshIntervalMs?: number;
+  sessionAutoSyncEnabled?: boolean;
+}
+
+const OVERVIEW_RANGE: UsageRangeSelection = { preset: "30d" };
+
+function compact(value: number, locale: string) {
+  return new Intl.NumberFormat(locale, {
+    notation: "compact",
+    maximumFractionDigits: 2,
+  }).format(value);
+}
+
+function money(value: string | number, locale: string) {
+  const numeric = Number(value);
+  if (!Number.isFinite(numeric)) return "—";
+  return new Intl.NumberFormat(locale, {
+    style: "currency",
+    currency: "USD",
+    maximumFractionDigits: 2,
+  }).format(numeric);
+}
+
+export function SubscriptionLensDashboard({
+  refreshIntervalMs = 30000,
+  sessionAutoSyncEnabled = true,
+}: SubscriptionLensDashboardProps) {
+  const { t, i18n } = useTranslation();
+  const locale = i18n.resolvedLanguage || i18n.language || "en";
+  const polling = refreshIntervalMs > 0 ? refreshIntervalMs : false;
+  const { data: summary } = useUsageSummary(
+    OVERVIEW_RANGE,
+    { appType: "codex" },
+    { refetchInterval: polling },
+  );
+  const { data: providers = [] } = useProviderStats(
+    OVERVIEW_RANGE,
+    { appType: "codex" },
+    { refetchInterval: polling },
+  );
+  const { data: models = [] } = useModelStats(
+    OVERVIEW_RANGE,
+    { appType: "codex" },
+    { refetchInterval: polling },
+  );
+  const { data: quota } = useQuery({
+    queryKey: ["subscription-lens", "codex-quota"],
+    queryFn: () =>
+      invoke<CodexQuotaResult>("get_codex_oauth_quota", {
+        accountId: null,
+      }),
+    retry: false,
+    refetchInterval: polling,
+  });
+
+  const totalTokens = summary?.realTotalTokens ?? 0;
+  const totalRequests = summary?.totalRequests ?? 0;
+  const cacheHit = Math.max(0, Math.min(100, (summary?.cacheHitRate ?? 0) * 100));
+  const maxProviderTokens = useMemo(
+    () => Math.max(1, ...providers.map((item) => item.totalTokens)),
+    [providers],
+  );
+  const maxModelTokens = useMemo(
+    () => Math.max(1, ...models.map((item) => item.totalTokens)),
+    [models],
+  );
+  const quotaTiers = quota?.success ? (quota.tiers ?? []) : [];
+
+  return (
+    <div className="space-y-8">
+      <section className="space-y-4 pt-2">
+        <div>
+          <h2 className="text-2xl font-bold tracking-tight">
+            {t("usage.subscriptionLensOverview", {
+              defaultValue: "Subscription Lens 总览",
+            })}
+          </h2>
+          <p className="text-sm text-muted-foreground">
+            {t("usage.subscriptionLensOverviewDescription", {
+              defaultValue: "最近 30 天的 Codex 套餐额度、成本和模型分布",
+            })}
+          </p>
+        </div>
+
+        <div className="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
+          {[
+            ["Tokens", compact(totalTokens, locale)],
+            [
+              t("usage.totalCost", { defaultValue: "API 等价成本" }),
+              money(summary?.totalCost ?? 0, locale),
+            ],
+            [
+              t("usage.cacheHitRate", { defaultValue: "缓存读取占比" }),
+              `${cacheHit.toFixed(1)}%`,
+            ],
+            [
+              t("usage.totalRequests", { defaultValue: "请求数" }),
+              totalRequests.toLocaleString(locale),
+            ],
+          ].map(([label, value]) => (
+            <Card key={label} className="border-border/60 bg-card/70">
+              <CardContent className="p-4">
+                <div className="text-xs text-muted-foreground">{label}</div>
+                <div className="mt-1 text-2xl font-semibold tabular-nums">
+                  {value}
+                </div>
+              </CardContent>
+            </Card>
+          ))}
+        </div>
+
+        {quotaTiers.length > 0 && (
+          <Card className="border-border/60 bg-card/70">
+            <CardHeader className="pb-3">
+              <CardTitle className="text-base">
+                {t("usage.subscriptionQuota", { defaultValue: "套餐额度" })}
+              </CardTitle>
+            </CardHeader>
+            <CardContent className="grid gap-4 md:grid-cols-2">
+              {quotaTiers.map((tier) => {
+                const remaining = Math.max(0, 100 - Number(tier.utilization || 0));
+                return (
+                  <div key={tier.name} className="space-y-2">
+                    <div className="flex items-center justify-between gap-3 text-sm">
+                      <span className="font-medium">{tier.name}</span>
+                      <span className="tabular-nums">{remaining.toFixed(0)}%</span>
+                    </div>
+                    <div className="h-2 overflow-hidden rounded-full bg-muted">
+                      <div
+                        className="h-full rounded-full bg-primary transition-[width]"
+                        style={{ width: `${remaining}%` }}
+                      />
+                    </div>
+                    {tier.resetsAt && (
+                      <div className="text-xs text-muted-foreground">
+                        {t("usage.resetAt", { defaultValue: "重置" })}: {" "}
+                        {new Date(tier.resetsAt).toLocaleString(locale)}
+                      </div>
+                    )}
+                  </div>
+                );
+              })}
+            </CardContent>
+          </Card>
+        )}
+
+        <div className="grid gap-4 xl:grid-cols-2">
+          <DistributionCard
+            title={t("usage.providerStats", { defaultValue: "供应商用量" })}
+            rows={providers.slice(0, 8).map((item) => ({
+              key: item.providerId,
+              label: item.providerName,
+              tokens: item.totalTokens,
+              cost: item.totalCost,
+              width: (item.totalTokens / maxProviderTokens) * 100,
+            }))}
+            locale={locale}
+          />
+          <DistributionCard
+            title={t("usage.modelStats", { defaultValue: "模型用量" })}
+            rows={models.slice(0, 8).map((item) => ({
+              key: item.model,
+              label: item.model,
+              tokens: item.totalTokens,
+              cost: item.totalCost,
+              width: (item.totalTokens / maxModelTokens) * 100,
+            }))}
+            locale={locale}
+          />
+        </div>
+      </section>
+
+      <div className="border-t border-border/60 pt-8">
+        <UsageDashboard
+          refreshIntervalMs={refreshIntervalMs}
+          sessionAutoSyncEnabled={sessionAutoSyncEnabled}
+        />
+      </div>
+    </div>
+  );
+}
+
+function DistributionCard({
+  title,
+  rows,
+  locale,
+}: {
+  title: string;
+  rows: Array<{
+    key: string;
+    label: string;
+    tokens: number;
+    cost: string;
+    width: number;
+  }>;
+  locale: string;
+}) {
+  return (
+    <Card className="border-border/60 bg-card/70">
+      <CardHeader className="pb-3">
+        <CardTitle className="text-base">{title}</CardTitle>
+      </CardHeader>
+      <CardContent className="space-y-3">
+        {rows.length === 0 ? (
+          <div className="py-8 text-center text-sm text-muted-foreground">—</div>
+        ) : (
+          rows.map((row) => (
+            <div key={row.key} className="space-y-1.5">
+              <div className="flex items-center justify-between gap-4 text-sm">
+                <span className="min-w-0 truncate font-medium" title={row.label}>
+                  {row.label}
+                </span>
+                <span className="shrink-0 tabular-nums text-muted-foreground">
+                  {compact(row.tokens, locale)} · {money(row.cost, locale)}
+                </span>
+              </div>
+              <div className="h-1.5 overflow-hidden rounded-full bg-muted">
+                <div
+                  className="h-full rounded-full bg-primary transition-[width]"
+                  style={{ width: `${Math.max(2, row.width)}%` }}
+                />
+              </div>
+            </div>
+          ))
+        )}
+      </CardContent>
+    </Card>
+  );
+}
