{
  "name": "subscription-lens",
  "version": "3.1.0",
  "description": "Local Codex subscription usage monitor",
  "main": "src/main.cjs",
  "author": "Subscription Lens contributors",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "verify:cc-switch-runtime": "node scripts/verify-cc-switch-runtime.cjs",
    "build:router": "node scripts/build-router-sidecar.cjs",
    "test": "node --test test/*.test.cjs",
    "dist": "node scripts/build-desktop.cjs",
    "dist:win": "electron-builder --win nsis zip --x64",
    "dist:mac": "node scripts/build-desktop.cjs",
    "postdist": "node scripts/write-sha256.cjs",
    "prestart": "node scripts/sync-cc-switch-codex-presets.cjs && node scripts/build-locales.cjs",
    "pretest": "node scripts/sync-cc-switch-codex-presets.cjs && node scripts/build-locales.cjs",
    "verify:router-sidecar": "node scripts/verify-router-sidecar.cjs",
    "smoke:providers": "node scripts/smoke-provider-editor.cjs",
    "predist": "npm run verify:cc-switch-runtime && npm run sync:cc-switch-ui && npm run build:router && npm run verify:router-sidecar && node scripts/build-locales.cjs",
    "sync:cc-switch-ui": "node scripts/sync-cc-switch-codex-presets.cjs"
  },
  "devDependencies": {
    "electron": "44.4.0",
    "electron-builder": "26.15.3",
    "playwright": "1.62.1"
  },
  "build": {
    "appId": "net.subscriptionlens.desktop",
    "productName": "Subscription Lens",
    "asar": true,
    "asarUnpack": [
      "assets/router/**"
    ],
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "LICENSE",
      "README.md",
      "docs/**/*",
      "ROADMAP.md",
      "THIRD-PARTY-NOTICES.md"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "afterPack": "scripts/after-pack.cjs",
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "zip"
      ],
      "signExecutable": false
    },
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.utilities",
      "identity": "-",
      "hardenedRuntime": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "en_US",
        "zh_CN",
        "nl_NL"
      ],
      "displayLanguageSelector": true,
      "guid": "4bb92857-80a8-5988-a91d-bc1fd9808cfa",
      "include": "assets/installer.nsh"
    },
    "artifactName": "Subscription-Lens-${version}-${arch}.${ext}"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zh3nggg/subscription-lens.git"
  },
  "homepage": "https://github.com/zh3nggg/subscription-lens",
  "bugs": {
    "url": "https://github.com/zh3nggg/subscription-lens/issues"
  }
}
